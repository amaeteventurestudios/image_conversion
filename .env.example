# Copy to .env and adjust. All values are optional.
PORT=3000
# Bind address. 127.0.0.1 when behind Caddy on the same host; 0.0.0.0 inside Docker.
HOST=127.0.0.1
# Where the SQLite database and temporary image files live.
DATA_DIR=./data
# Uploaded and converted files are deleted after this many hours.
FILE_TTL_HOURS=6
MAX_FILE_MB=60
# Parallel image jobs. 2 is a good fit for a Raspberry Pi 4 (4 GB).
CONCURRENCY=2
# How long a non-"trusted device" login lasts.
SESSION_HOURS=12
# "auto" marks cookies Secure when the request came over HTTPS (via the proxy).
COOKIE_SECURE=auto
# Which proxies to trust for X-Forwarded-* headers (Express syntax).
TRUST_PROXY=loopback
