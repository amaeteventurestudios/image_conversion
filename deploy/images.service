# Native (non-Docker) install. Copy to /etc/systemd/system/images.service
[Unit]
Description=Images (private image converter)
After=network-online.target
Wants=network-online.target

[Service]
User=images
WorkingDirectory=/opt/images
EnvironmentFile=/opt/images/.env
Environment=NODE_ENV=production
ExecStart=/usr/bin/node /opt/images/node_modules/.bin/tsx server/index.ts
Restart=on-failure
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/images/data
MemoryMax=1500M

[Install]
WantedBy=multi-user.target
